<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cologne-transit-intelligence.mdd-collector</string>

    <!-- Prepared only. Keep this job disabled until the controlled cutover. -->
    <key>Disabled</key>
    <true/>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>ThrottleInterval</key>
    <integer>300</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>/Users/admin/Documents/cologne-transit-intelligence</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>python3</string>
        <string>-m</string>
        <string>cologne_transit_collector.macos_runner</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/admin/Documents/cologne-transit-intelligence/src</string>
        <key>COLLECTOR_MAC_SQL_ENABLED</key>
        <string>0</string>
        <key>COLLECTOR_WINDOWS_RUNTIME_STATE</key>
        <string>UNCONFIRMED</string>
        <key>COLLECTOR_CUTOVER_APPROVED</key>
        <string>0</string>
        <key>COLLECTOR_MAC_SQL_TARGET_SCOPE</key>
        <string>UNAPPROVED</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/admin/Library/Logs/CologneTransitIntelligence/mdd-collector.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/admin/Library/Logs/CologneTransitIntelligence/mdd-collector.err.log</string>
</dict>
</plist>
