# Local environment template — all values below are intentionally fake.
# Copy this file to .env and replace every value before using it:
#   cp .env.example .env
# Never commit .env.

# Stage 14 collector (offline plan/dry-run/simulate do not require a key).
# Production live remains blocked; S78 live-research requires explicit CLI
# opt-in, an external live root/database, and this inherited key.
MDD_API_KEY=
COLLECTOR_STATE_PATH=.local/stage14/collector.sqlite3
COLLECTOR_LIVE_RESEARCH_ROOT=
COLLECTOR_LIVE_RESEARCH_DB=
COLLECTOR_HEARTBEAT_SAFETY_MARGIN_SECONDS=5

# Prepared direct macOS-to-authoritative-database adapter. Credentials are
# external-only; leave the cutover gates closed until the controlled decision.
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=CologneTransitIntelligence
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_LOGIN_TIMEOUT_SECONDS=8
MSSQL_QUERY_TIMEOUT_SECONDS=30
MSSQL_RAW_EVIDENCE_DIR=.local/mdd-raw-evidence
COLLECTOR_MAC_SQL_ENABLED=0
COLLECTOR_WINDOWS_RUNTIME_STATE=UNCONFIRMED
COLLECTOR_CUTOVER_APPROVED=0
COLLECTOR_MAC_SQL_TARGET_SCOPE=UNAPPROVED
COLLECTOR_MAC_SQL_VALIDATION_POLICY=OFFLINE_RECONCILIATION_ONLY

# Separate administrative evidence capture only. These values never fall back
# to the limited runtime login. Keep the password and signing key outside the
# repository; the signed evidence artifact must be fresh and read-only.
MSSQL_ADMIN_HOST=
MSSQL_ADMIN_PORT=1433
MSSQL_ADMIN_DATABASE=CologneTransitIntelligence
MSSQL_ADMIN_USER=
MSSQL_ADMIN_PASSWORD=
MSSQL_ADMIN_LOGIN_TIMEOUT_SECONDS=8
MSSQL_ADMIN_QUERY_TIMEOUT_SECONDS=30
MSSQL_ADMIN_EVIDENCE_PUBLIC_KEY=

# The variables below are retained as historical deployment placeholders only.
# S78 does not install, configure, connect to, or require PostgreSQL.

# Remote production server / SSH connection
SERVER_IP=203.0.113.10
SSH_USERNAME=deploy_user
SSH_PASSWORD=change_me_ssh_mock_only
SSH_PORT=22

# PostgreSQL container
POSTGRES_USER=transit_app
POSTGRES_PASSWORD=change_me_postgres_mock_only
POSTGRES_CONTAINER_PORT=5432
POSTGRES_DB=cologne_transit

# pgAdmin web login (optional; not a separate PostgreSQL user)
# These are used only when pgAdmin is deployed with the official container image.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_mock_only
